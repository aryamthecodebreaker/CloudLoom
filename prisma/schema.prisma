generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CloudAccount {
  id          String     @id @default(cuid())
  name        String
  provider    String
  externalId  String
  status      String
  lastScanAt  DateTime?
  resources   Resource[]
  createdAt   DateTime   @default(now())
}

model Project {
  id        String     @id @default(cuid())
  name      String
  team      String
  resources Resource[]
}

model Resource {
  id               String        @id @default(cuid())
  name             String
  type             String
  provider         String
  region           String
  externalId       String
  isPublic         Boolean       @default(false)
  hasSensitiveData Boolean       @default(false)
  tags             String        @default("{}")
  cloudAccountId   String
  cloudAccount     CloudAccount  @relation(fields: [cloudAccountId], references: [id])
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id])
  issues           Issue[]
  vulnerabilities  Vulnerability[]
}

model Control {
  id          String  @id @default(cuid())
  controlId   String
  name        String
  description String
  category    String
  severity    String
  queryHint   String
  issues      Issue[]
}

model Issue {
  id            String   @id @default(cuid())
  refId         String
  title         String
  description   String
  status        String
  severity      String
  attackPathJson String?
  control       Control  @relation(fields: [controlId], references: [id])
  controlId     String
  resource      Resource @relation(fields: [resourceId], references: [id])
  resourceId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([refId])
}

model Vulnerability {
  id              String   @id @default(cuid())
  cveId           String
  cvss            Float
  severity        String
  packageName     String
  installedVersion String
  fixedVersion    String
  exploitedInWild Boolean  @default(false)
  description     String
  resource        Resource @relation(fields: [resourceId], references: [id])
  resourceId      String

  @@unique([cveId, resourceId])
}

model ComplianceFramework {
  id     String @id @default(cuid())
  name   String
  family String
  passed Int
  failed Int
}
