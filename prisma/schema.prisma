generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CloudAccount {
  id          String     @id @default(cuid())
  name        String
  provider    String
  externalId  String
  status      String
  lastScanAt  DateTime?
  resources   Resource[]
  createdAt   DateTime   @default(now())

  @@unique([provider, externalId])
}

model Project {
  id        String     @id @default(cuid())
  name      String
  team      String
  resources Resource[]
}

model Resource {
  id               String        @id @default(cuid())
  name             String
  type             String
  provider         String
  region           String
  externalId       String
  isPublic         Boolean       @default(false)
  hasSensitiveData Boolean       @default(false)
  tags             String        @default("{}")
  lastScanAt       DateTime?
  cloudAccountId   String
  cloudAccount     CloudAccount  @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id])
  issues           Issue[]
  vulnerabilities  Vulnerability[]
  edgesOut         GraphEdge[]   @relation("edgesOut")
  edgesIn          GraphEdge[]   @relation("edgesIn")

  @@unique([externalId, cloudAccountId])
}

model Control {
  id          String  @id @default(cuid())
  controlId   String
  name        String
  description String
  category    String
  severity    String
  queryHint   String
  issues      Issue[]
}

model Issue {
  id            String   @id @default(cuid())
  refId         String
  title         String
  description   String
  status        String
  severity      String
  attackPathJson String?
  control       Control  @relation(fields: [controlId], references: [id])
  controlId     String
  resource      Resource @relation(fields: [resourceId], references: [id])
  resourceId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([refId])
  @@index([status])
  @@index([severity])
}

model Vulnerability {
  id              String   @id @default(cuid())
  cveId           String
  cvss            Float
  severity        String
  packageName     String
  installedVersion String
  fixedVersion    String
  exploitedInWild Boolean  @default(false)
  description     String
  resource        Resource @relation(fields: [resourceId], references: [id])
  resourceId      String

  @@unique([cveId, resourceId])
}

model ComplianceFramework {
  id     String @id @default(cuid())
  name   String @unique
  family String
  passed Int
  failed Int
}

model GraphEdge {
  id     String   @id @default(cuid())
  kind   String
  fromId String
  from   Resource @relation("edgesOut", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Resource @relation("edgesIn", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, kind, toId])
  @@index([fromId])
  @@index([toId])
}

model CloudEvent {
  id     String   @id @default(cuid())
  ts     DateTime
  actor  String
  action String
  target String
  result String
  source String

  @@index([ts])
}
