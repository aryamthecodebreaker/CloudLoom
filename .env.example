# Any Postgres works — local Docker, Neon, Supabase, RDS...
DATABASE_URL="postgresql://user:<password>@host:5432/cloudloom"
#
# Deploying to a serverless host (Vercel, Lambda)? Use your provider's
# TRANSACTION pooler, not the session pooler, and tell Prisma about it.
# A session pooler holds one Postgres connection per client, so concurrent
# function instances exhaust the database and requests fail with P2024
# ("Timed out fetching a new connection from the connection pool").
#
# Supabase — port 6543 rather than 5432:
#   DATABASE_URL="postgresql://user:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
#
# Prisma migrations need a direct connection; keep 5432 for those:
#   DIRECT_URL="postgresql://user:<password>@<host>:5432/postgres"

# Session signing secret — REQUIRED. Auth fails to boot without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Real cloud ingestion (optional): the Go agent pushes discovered resources
# to POST /api/ingest with `Authorization: Bearer <INGEST_TOKEN>`.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=""

# Optional: Slack-style webhook for alerts (suspicious drift, critical findings)
# WEBHOOK_URL="https://hooks.slack.com/services/..."