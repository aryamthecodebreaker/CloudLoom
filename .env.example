# Any Postgres works — local Docker, Neon, Supabase, RDS...
DATABASE_URL="postgresql://user:<password>@host:5432/cloudloom"

# Real cloud ingestion (optional): the Go agent pushes discovered resources
# to POST /api/ingest with `Authorization: Bearer <INGEST_TOKEN>`.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=""
